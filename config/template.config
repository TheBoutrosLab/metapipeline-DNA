includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

import nextflow.Nextflow

params {
    input_csv = '' // Path to input CSV if inputs are being given through CSV; if using YAML inputs, remove this parameter from the config
    output_dir = ''
    leading_work_dir = '' //Should be a /hot/path | Can't use /scratch
    pipeline_work_dir = '/scratch' //For individual pipeline outputs before copying to output_dir
    project_id = ''
    save_intermediate_files = false // Metapipeline-level intermediate files

    // If specified, an email will be sent to this address for every pipeline
    // start and completion
    status_email_address = ""

    partition = 'F72'
    clusterOptions = '--exclusive'

    max_parallel_jobs = 5
    // How long to wait between job submissions, in minutes. Default: 90
    // If WGS mode below is enabled, the interval will be replaced by the defaults for WGS mode and WGS queue
    cluster_submission_interval = 90

    /**
    *   Workflow finalization with recalibrate-BAM and align-DNA cleanup
    */
    finalization_cram_recalibrated_bams = true
    finalization_delete_alignment_bams = true
    finalization_delete_recalibrated_bams = true

    finalization_queue = 'F72'
    finalization_cluster_options = ''
    finalization_max_conversions = 1
    finalization_max_alignment_deletions = 1

    // Whether to run samples in WGS queue with WGS rate limit
    // Disable for non-WGS samples
    uclahs_cds_wgs = true

    sample_mode = 'paired' // Choose from: 'single', 'paired', 'multi'

    // Select pipeline(s) to run. Choices: 'align-DNA', 'recalibrate-BAM', 'generate-SQC-BAM', 'calculate-targeted-coverage', 'call-gSNP', 'call-mtSNV', 'call-sSNV', 'call-sSV', 'call-gSV', 'call-sCNA', 'StableLiftsSNV', 'StableLiftsSV', 'StableLiftgSV', 'StableLiftgSNP', 'annotate-gSNP', 'annotate-sSNV', 'call-GeneticAncestry', 'calculate-mtDNA-CopyNumber'
    requested_pipelines = ['align-DNA', 'recalibrate-BAM', 'generate-SQC-BAM', 'call-gSNP', 'call-mtSNV', 'call-sSNV', 'call-sSV', 'call-gSV', 'call-sCNA', 'annotate-gSNP', 'call-GeneticAncestry', 'calculate-mtDNA-CopyNumber']

    // Override conversion to FASTQ and re-alignment with BAM input
    override_realignment = false

    // Override recalibrate-BAM
    override_recalibrate_bam = false

    // Pass available contamination tables to call-sSNV
    use_contamination_tables = true

    // Aligner whose BAM is used by downstream pipelines. If unset, BWA-MEM2 is
    // preferred when selected; otherwise, the first configured aligner is used.
    // primary_aligner = 'BWA-MEM2'

    /**
    Targeted mode options

    When targeted-coverage is enabled, control whether the original provided intervals for the pipelines should be used
    By default, with this option disabled, the expanded intervals from targeted-coverage will be used
    */
    use_original_intervals = false


    // If using Apptainer as the containerization system, optionally uncomment and provide the following params to set cache and library directories
    // apptainer_library = ''
    // apptainer_cache = ''

    // If using Singularity as the containerization system, optionally uncomment and provide the following params to set cache and library directories
    // singularity_library = ''
    // singularity_cache = ''

    // Specify per-pipeline allocations here for resource loading
    // Pipelines will automatically use the profile tag if available and the CPUs/Memory specifications if not
    // pipeline_cpus = 32
    // pipeline_memory = '64.G'
    // resource_allocation_profile_tag = 'f32'

    // Pipeline-specific params under each respective pipeline
    pipeline_params {
        convert_BAM2FASTQ {
            reference_fasta = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta'
            filter_qc_failed_reads = false
            split_unmapped_reads_to_separate_file = false
            compression_level = 9
            // Uncomment to set read group tag values to override that from the original BAMs.
            // This can also be usful if you know your BAM files don't have those tags.
            // sequencing_center =
            // platform_unit =
            // id_for_pu =
        }

        align_DNA {
            enable_spark = true
            mark_duplicates = true
            reference_fasta_bwa = '/path/to/BWA-MEM2-2.2.1/GRCh38-BI-20160721/alt-aware/genome.fa'
            aligner = ['BWA-MEM2']
        }

        recalibrate_BAM {
            aligner = "BWA-MEM2-2.3"
            reference_fasta = "/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta"
            bundle_mills_and_1000g_gold_standard_indels_vcf_gz = "/path/to/GATK/GRCh38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
            bundle_known_indels_vcf_gz = "/path/to/GATK/GRCh38/Homo_sapiens_assembly38.known_indels.vcf.gz"
            bundle_v0_dbsnp138_vcf_gz = "/path/to/GATK/GRCh38/resources_broad_hg38_v0_Homo_sapiens_assembly38.dbsnp138.vcf.gz"
            bundle_contest_hapmap_3p3_vcf_gz = "/path/to/GATK/GRCh38/Biallelic/hapmap_3.3.hg38.BIALLELIC.PASS.2021-09-01.vcf.gz"
            parallelize_by_chromosome = true
            reference_fasta_fai = "${params.pipeline_params.recalibrate_BAM.reference_fasta}.fai"
            reference_fasta_dict = "${Nextflow.file(params.pipeline_params.recalibrate_BAM.reference_fasta).resolveSibling(Nextflow.file(params.pipeline_params.recalibrate_BAM.reference_fasta).getBaseName() + '.dict')}"
            bundle_known_indels_vcf_gz_tbi = "${params.pipeline_params.recalibrate_BAM.bundle_known_indels_vcf_gz}.tbi"
            bundle_contest_hapmap_3p3_vcf_gz_tbi = "${params.pipeline_params.recalibrate_BAM.bundle_contest_hapmap_3p3_vcf_gz}.tbi"
            bundle_mills_and_1000g_gold_standard_indels_vcf_gz_tbi = "${params.pipeline_params.recalibrate_BAM.bundle_mills_and_1000g_gold_standard_indels_vcf_gz}.tbi"
            bundle_v0_dbsnp138_vcf_gz_tbi = "${params.pipeline_params.recalibrate_BAM.bundle_v0_dbsnp138_vcf_gz}.tbi"
        }

        calculate_targeted_coverage {
            reference_dict = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.dict'
            reference_dbSNP = '/path/to/dbSNP-155/thinned/GRCh38/dbSNP-155_thinned_hg38.vcf.gz'
            genome_sizes = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta.fai'
            target_bed = 'path/to/target/bedfile' //required
            bait_bed = '' //optional, path/to/bait/bedfile
            collect_metrics = true // whether or not to calculate coverage metrics
            off_target_depth = true //whether or not to calculate depth at off-target dbSNP loci
            output_enriched_target_file = true // whether or not to output a new target file containing high-coverage off-target dbSNP loci
            target_depth = false // whether or not to calculate per-base depth in target regions
        }

        generate_SQC_BAM {
            algorithm = ['samtools_stats', 'collectwgsmetrics']
            reference = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta'
        }

        call_gSNP {
            algorithm = ['HaplotypeCaller', 'DeepVariant']
            reference_fasta = "/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta"
            bundle_mills_and_1000g_gold_standard_indels_vcf_gz = "/path/to/GATK/GRCh38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
            bundle_v0_dbsnp138_vcf_gz = "/path/to/GATK/GRCh38/resources_broad_hg38_v0_Homo_sapiens_assembly38.dbsnp138.vcf.gz"
            bundle_hapmap_3p3_vcf_gz = "/path/to/GATK/GRCh38/hapmap_3.3.hg38.vcf.gz"
            bundle_omni_1000g_2p5_vcf_gz = "/path/to/GATK/GRCh38/1000G_omni2.5.hg38.vcf.gz"
            bundle_phase1_1000g_snps_high_conf_vcf_gz = "/path/to/GATK/GRCh38/1000G_phase1.snps.high_confidence.hg38.vcf.gz"
        }

        call_sSNV {
            algorithm = ['somaticsniper', 'strelka2', 'mutect2', 'muse', 'deepsomatic']
            reference = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta'
            exome = false
            intersect_regions = '/path/to/pipeline-call-sSNV-6.0.0/GRCh38-BI-20160721/Homo_sapiens_assembly38_no-decoy.bed.gz'
            germline_resource_gnomad_vcf = '/path/to/GATK/GRCh38/af-only-gnomad.hg38.vcf.gz'
            dbSNP = '/path/to/dbSNP-155/original/GRCh38/GCF_000001405.39.gz'
            ncbi_build = 'GRCh38'
        }

        call_mtSNV {
            mt_ref_genome_dir = '/path/to/mitochondria_ref/genome_fasta/'
            gmapdb = '/path/to/mitochondria_ref/gmapdb/gmapdb_2025-04-19/'
            downsample_mtoolbox_bam = false // options: [true, false]
            probability_downsample = 0.5
            downsample_strategy = 'HighAccuracy' // options: ['HighAccuracy', 'ConstantMemory', 'Chained']
            downsample_accuracy = "1.0E-4"
            reference_genome_version = "GRCh38"
        }

        call_gSV {
            reference_fasta = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta'
            exclusion_file = '/path/to/Delly/GRCh38/human.hg38.excl.tsv'
            mappability_map = '/path/to/Delly/GRCh38/Homo_sapiens.GRCh38.dna.primary_assembly.fa.r101.s501.blacklist.gz'
        }

        call_sSV {
            algorithm = ['delly', 'manta']
            reference_fasta = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta'
            exclusion_file = '/path/to/Delly/hg38/human.hg38.excl.tsv'
            svision_cnn_model = '/path/to/SVision/model.ckpt'
            gridss2_blacklist = "/path/to/list.bed"
            gridss2_reference_fasta = "/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta"
            gridss2_pon_dir = "/path/to/pon/dir"
        }

        call_sCNA {
            algorithm = ['Battenberg', 'cnv_facets']
            position_scale = "genome-position"
            dbSNP_file = "/path/to/RecSNV/GRCh38/dbsnp_b150_grch38.vcf.gz"
            battenberg_reference = "/path/to/Battenberg/download_202204/GRCh38/battenberg_ref_hg38_chr/"
            reference_dict = "/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.dict"
            genome_build = "GRCh38"
            min_rho = 0.1
            max_rho = 1.0
            min_psi = 1.6
            max_psi = 4.8
            min_goodness_of_fit = 0.63
            balanced_threshold = 0.51
            min_normal_depth = 10
            min_base_qual = 20
            min_map_qual = 35
            snp_mapq = 1
            snp_baq = 30
            depth = [25, 2500]
            cval = [25, 400]
            nbhdsnp = 250
            rnd_seed = 0
            snp_count_orphans = true
        }

        call_SRC {
            SRC = [
                [
                    algorithm: 'PyClone-VI',
                    options: ''
                ]
            ]
        }

        StableLift {
            liftover_direction = "GRCh37ToGRCh38"

            stablelift_models = params.stablelift_models

            fasta_ref_37 = "/path/to/GRCh37-EBI-hs37d5/hs37d5.fa"
            fasta_ref_38 = "/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta"
            resource_bundle_path = "/path/to/BNCH-000142-GRCh37v38/publish/resource"
            funcotator_data_source = "/path/to/BNCH-000142-GRCh37v38/publish/resource/funcotator_dataSources.v1.7.20200521s_StableLift"
        }

        annotate_VCF {
            algorithm = ['SnpEff', 'Funcotator', 'VEP']
            genome_version = 'hg38'

            skip_normalization = false

            SnpEff_data_dir = '/path/to/SnpEff/data/'
            SnpEff_download = false
            SnpSift_annotate_database = ['/path/to/ClinVar-20230722/original/GRCh38/clinvar_20230722.vcf.gz', '/path/to/AlphaMissense_hg38_converted.vcf.gz']
            skip_SnpEff = false

            reference_fasta = '/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.fasta'

            Funcotator_data_source = '/path/to/Funcotator/somatic/funcotator_dataSources.v1.7.20200521s'
            Funcotator_output_format = 'VCF' // 'VCF' or 'MAF'
            Funcotator_b37_to_hg19_conversion = false
            Funcotator_extra_options = ''

            vep_cache = '/path/to/VEP-116.2/GRCh38-EBI-ENSEMBL101'
            chromosomes = 'chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY,chrM'
            genome_assembly_version = 'GRCh38'
            genome_annotation_version = 'GENCODEv34'
            genome_fasta = '/path/to/GRCh38-EBI-GENCODE34/GRCh38.p13.genome.fa'
            annotation_gtf = '/path/to/GRCh38-EBI-GENCODE34/gencode.v34.chr_patch_hapl_scaff.annotation.sorted.gtf.gz'
        }

        call_GeneticAncestry {
            reference_vcf = '/path/to/pipeline-call-GeneticAncestry/Nextflow/development/test-inputs/ref/thousand-genomes/ALL_phase3.GRCh38.GT.crossmap.MAF_lt_0.1_snps_biallelic_annotated-sample-set.vcf.gz'
            reference_dir = '/path/to/pipeline-call-GeneticAncestry/Nextflow/development/test-inputs/ref/thousand-genomes'
            reference_set = '1KG_unrelated_hg38.MAF_lt_0.1_snps_biallelic'

            reference_zst = '/path/to/pipeline-call-GeneticAncestry/Nextflow/development/test-inputs/ref/plink-human-genome/GRCh38_full_analysis_set_plus_decoy_hla.fa.zst'

            reference_short = 'b38'
            reference_ancestry_annotations = '/path/to/pipeline-call-GeneticAncestry/Nextflow/development/test-inputs/ref/thousand-genomes/1KG_unrelated_hg38.MAF_lt_0.1_snps_biallelic.psam'
            annotations_sample_column = 1
            annotations_ancestry_column = 5
            aim_bed = '/path/to/pipeline-call-GeneticAncestry/Nextflow/development/test-inputs/ref/ancestry-informative-markers/AIM_hg38_simple.bed'
            reference_output_prefix = '1KG'

            admixture_k = 5
            admixture_CPU = 15
            PCA_max_K = 30
        }

        calculate_mtDNA_CopyNumber {

        }
    }
}

methods.set_up()
