params {
    // Output finalization options.
    finalization_cram_recalibrated_bams = true
    finalization_delete_alignment_bams = true
    finalization_delete_recalibrated_bams = true
    finalization_executor = 'slurm'

    save_intermediate_files = false
    executor = 'slurm'
    clusterOptions = ''
    ucla_cds = true

    uclahs_cds_wgs = true
    global_rate_limit = 90 // 90-minute global submission rate limit

    global_job_submission_limiter = ""
    global_job_submission_sbatch = ""

    run_downstream_pipelines_serially = false

    override_src_precursor_disable = false
    src_snv_tool = 'BCFtools-Intersect'
    src_cna_tool = 'Battenberg'

    // StableLift model definition
    test_base = "/path/to/tool-specific-input/StableLift-1.1.0"
    model_37_38 = "${test_base}/model/GRCh37-to-GRCh38/RF-model_GRCh37-to-GRCh38"
    model_38_37 = "${test_base}/model/GRCh38-to-GRCh37/RF-model_GRCh38-to-GRCh37"

    stablelift_models = [
        GRCh37ToGRCh38: [
            HaplotypeCaller: "${model_37_38}_gSNP_HaplotypeCaller.Rds",
            Muse2:           "${model_37_38}_sSNV_Muse2.Rds",
            Mutect2:         "${model_37_38}_sSNV_Mutect2.Rds",
            SomaticSniper:   "${model_37_38}_sSNV_SomaticSniper.Rds",
            Strelka2:        "${model_37_38}_sSNV_Strelka2.Rds",
            "Delly2-gSV":    "${model_37_38}_gSV_Delly2-gSV.Rds",
            "Delly2-sSV":    "${model_37_38}_sSV_Delly2-sSV.Rds"
        ],
        GRCh38ToGRCh37: [
            HaplotypeCaller: "${model_38_37}_gSNP_HaplotypeCaller.Rds",
            Muse2:           "${model_38_37}_sSNV_Muse2.Rds",
            Mutect2:         "${model_38_37}_sSNV_Mutect2.Rds",
            SomaticSniper:   "${model_38_37}_sSNV_SomaticSniper.Rds",
            Strelka2:        "${model_38_37}_sSNV_Strelka2.Rds",
            "Delly2-gSV":    "${model_38_37}_gSV_Delly2-gSV.Rds",
            "Delly2-sSV":    "${model_38_37}_sSV_Delly2-sSV.Rds"
        ]
    ]

    // Run Mutect2 on only normal sample regardless of run mode
    ssnv_run_normal_only_mutect2 = false

    // Run Mutect2 (and DeepSomatic if requested) on tumor samples in tumor-only mode regardless of run mode
    ssnv_run_all_tumor_only = false

    // Pass available contamination tables to call-sSNV
    use_contamination_tables = true

    // TO-DO: Support option below to run call-SRC on all combinations of sSNV tools and sCNA tools
    src_run_all_combinations = false

    status_email_address = ""
}

process {
    executor = 'local'
    echo = false

    withLabel: 'finalization_executor' {
        // Resolve after user config has set its parameters. The executor
        // directive takes a string, so use deferred string interpolation.
        executor = "${-> params.finalization_executor}"
        queue = { params.finalization_queue }
        clusterOptions = { params.finalization_cluster_options }
    }

    withName: 'call_metapipeline_DNA' {
        errorStrategy = 'ignore'
    }
}

profiles {
    standard {
        params.containerization_system = "docker"

        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    // Define copy of default standard profile as docker to allow explicit docker selection
    // Profile aliasing isn't directly available so profile is copied
    docker {
        params.containerization_system = "docker"

        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    apptainer {
        params.containerization_system = "apptainer"

        docker {
            enabled = false
        }

        singularity {
            enabled = false
        }

        apptainer {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
    }

    singularity {
        params.containerization_system = "singularity"

        docker {
            enabled = false
        }

        apptainer {
            enabled = false
        }

        singularity {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
    }
}
